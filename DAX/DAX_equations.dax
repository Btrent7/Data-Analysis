-- -- -- -- -- -- -- -- -- -- -- -- --  
      --- DAX Equation Notes ---
-- -- -- -- -- -- -- -- -- -- -- -- --  


-- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --  
      --- Partition By Customer ---
-- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- -- 
MAX ORDRQTY = 
    CALCULATE(
        MAX('Generic Sales'[ORDER_QTY]),
        ALLEXCEPT('Generic Sales', 'Generic Sales'[CUST_NAME])
    )



 
-- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --
      --- Forecast Growth % ---
-- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- -- 
Avg. Growth % = 
VAR diff23 = IF([CY_2023] + [CY_2022] <> 0, MIN(([CY_2023] - [CY_2022]) / ([CY_2023] + [CY_2022]), 1), 0)
VAR diff24 = IF([CY_2024] + [CY_2023] <> 0, MIN(([CY_2024] - [CY_2023]) / ([CY_2024] + [CY_2023]), 1), 0)
VAR diff25 = IF([CY_2025] + [CY_2024] <> 0, MIN(([CY_2025] - [CY_2024]) / ([CY_2025] + [CY_2024]), 1), 0)
VAR CurrMonth = MONTH(TODAY())

RETURN
IF( 
    [CY_2025] + [CY_2024] = 0, 0,
    IF(
        SalesTable[calendarMonth] < CurrMonth,
        MAX((diff23 + (diff24) + (diff25)) / 3, -1),
        MAX((diff23 + (3*diff24)) / 4, -1)
      )
)




-- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --
      --- Forecast w/ Products ---
-- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- -- 
2026 FORECAST = 
VAR SumSales =
    (1 * [CY_2022]) +
    (2 * [CY_2023]) +
    (3 * [CY_2024]) +
    (4 * [2025 PRJ. FINISH])
VAR BaseForecast = SumSales / 10
VAR CategoryAdj = SWITCH (
        SalesTable[Category],
        "Steel Pipe", BaseForecast * (1 - 0.55),
        "Flex Products", BaseForecast * (1 + 1.5 * [AVG% DIFF]),
        "Grooved", BaseForecast * (1 + 2 * [AVG% DIFF]),
        "FAB", 0,
        BaseForecast * (1 + [AVG% DIFF])
        )
RETURN
    IF (
        [2025 PRJ. FINISH] = 0 || SalesTable[VNDID] = "TGI05" || SalesTable[VNDID] = "",
        0,
        CategoryAdj
    )




-- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --
--- Forecast Current Year Growth % ---
-- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- -- 
Current Year Revenue Growth% = 
VAR CurrentDate = TODAY()
VAR LastFullMonth = MONTH(EOMONTH(CurrentDate, -1))
VAR Revenue2025 =
    CALCULATE(
        [Revenue 2025],
        FILTER(
            'Sales_Normal',
            YEAR('Sales_Normal'[invoiceDate]) = 2025 &&
            MONTH('Sales_Normal'[invoiceDate]) <= LastFullMonth
        )
    )
VAR Revenue2024 =
    CALCULATE(
        [Revenue 2024],
        FILTER(
            'Sales_Normal',
            YEAR('Sales_Normal'[invoiceDate]) = 2024 &&
            MONTH('Sales_Normal'[invoiceDate]) <= LastFullMonth
        )
    )
VAR Diff = Revenue2025 - Revenue2024
VAR DiffPct = DIVIDE(Diff, Revenue2024)
RETURN
    IF(Revenue2025 > 0, DiffPct, BLANK())




-- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --
      --- Annual Revenue CY ---
-- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- -- 
Revenue Last Year = 
    CALCULATE(
        SUM('Sales_Normal'[Revenue]), 
            FILTER('Sales_Normal', 
                'Sales_Normal'[invoiceDate] >= DATE(2024, 1, 1) &&
                'Sales_Normal'[invoiceDate] <= DATE(2024, 12, 31
                )
            )
        )




-- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --
    --- Last Full Month Revenue ---
-- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- -- 
Revenue This Year (Last Full Month) = 
VAR CurrentDate = TODAY()
VAR LastFullMonthEnd = EOMONTH(CurrentDate, -1)
RETURN
CALCULATE(
    SUM('Sales_Normal'[Revenue]),
    FILTER(
        'Sales_Normal',
        YEAR('Sales_Normal'[invoiceDate]) = 2025 &&
        'Sales_Normal'[invoiceDate] <= LastFullMonthEnd
    )
)




-- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --
    --- 6 Month Simple Forecast to Actual ---
-- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- --  -- -- -- -- -- -- -- -- -- -- -- -- -- 
Forecast 6Mo Simple = 
VAR CurrentMo = MONTH( TODAY() )

/* --- Return the correct month for the current row context --- */
VAR ContextYear  = MAX ( Dim_Date[calendarYear] )
VAR ContextMonth = MAX ( Dim_Date[calendarMonth] )

/* Helper: actual monthly units for a specific Year/Month */
VAR UnitsForMonth =
    // This is a pattern: we’ll reuse it by copy (DAX doesn't have inline functions)
    0

/* --- Actuals needed to seed the chain (Jul–Dec 2025) --- */
VAR Jul25 =
    CALCULATE (
        SUM ( Fact_SalesTable[QTYSOLD] ),
        REMOVEFILTERS ( Dim_Date ),
        Dim_Date[calendarYear] = 2025,
        Dim_Date[calendarMonth] = 7
    )
VAR Aug25 =
    CALCULATE (
        SUM ( Fact_SalesTable[QTYSOLD] ),
        REMOVEFILTERS ( Dim_Date ),
        Dim_Date[calendarYear] = 2025,
        Dim_Date[calendarMonth] = 8
    )
VAR Sep25 =
    CALCULATE (
        SUM ( Fact_SalesTable[QTYSOLD] ),
        REMOVEFILTERS ( Dim_Date ),
        Dim_Date[calendarYear] = 2025,
        Dim_Date[calendarMonth] = 9
    )
VAR Oct25 =
    CALCULATE (
        SUM ( Fact_SalesTable[QTYSOLD] ),
        REMOVEFILTERS ( Dim_Date ),
        Dim_Date[calendarYear] = 2025,
        Dim_Date[calendarMonth] = 10
    )
VAR Nov25 =
    CALCULATE (
        SUM ( Fact_SalesTable[QTYSOLD] ),
        REMOVEFILTERS ( Dim_Date ),
        Dim_Date[calendarYear] = 2025,
        Dim_Date[calendarMonth] = 11
    )
VAR Dec25 =
    CALCULATE (
        SUM ( Fact_SalesTable[QTYSOLD] ),
        REMOVEFILTERS ( Dim_Date ),
        Dim_Date[calendarYear] = 2025,
        Dim_Date[calendarMonth] = 12
    )


VAR Jan26 = DIVIDE ( Jul25 + Aug25 + Sep25 + Oct25 + Nov25 + Dec25, 6 )

VAR Feb26 = DIVIDE ( Aug25 + Sep25 + Oct25 + Nov25 + Dec25 + Jan26, 6 )

VAR Mar26 = DIVIDE ( Sep25 + Oct25 + Nov25 + Dec25 + Jan26 + Feb26, 6 )

VAR Apr26 = DIVIDE ( Oct25 + Nov25 + Dec25 + Jan26 + Feb26 + Mar26, 6 )

VAR May26 = DIVIDE ( Nov25 + Dec25 + Jan26 + Feb26 + Mar26 + Apr26, 6 )

VAR Jun26 = DIVIDE ( Dec25 + Jan26 + Feb26 + Mar26 + Apr26 + May26, 6 )

VAR Jul26 = DIVIDE ( Jan26 + Feb26 + Mar26 + Apr26 + May26 + Jun26, 6 )

VAR Aug26 = DIVIDE ( Feb26 + Mar26 + Apr26 + May26 + Jun26 + Jul26, 6 )

VAR Sep26 = DIVIDE ( Mar26 + Apr26 + May26 + Jun26 + Jul26 + Aug26, 6 )

VAR Oct26 = DIVIDE ( Apr26 + May26 + Jun26 + Jul26 + Aug26 + Sep26, 6 )

VAR Nov26 = DIVIDE ( May26 + Jun26 + Jul26 + Aug26 + Sep26 + Oct26, 6 )

VAR Dec26 = DIVIDE ( Jun26 + Jul26 + Aug26 + Sep26 + Oct26 + Nov26, 6 )

RETURN
SUMX(
    KEEPFILTERS( 
        VALUES ( 'Dim_Date'[calendarMonth] ) ),
    SWITCH (
        TRUE (),
        ContextMonth = 1, Jan26,
        ContextMonth = 2, Feb26,
        ContextMonth = 3, Mar26,
        ContextMonth = 4, Apr26,
        ContextMonth = 5, May26,
        ContextMonth = 6, Jun26,
        ContextMonth = 7, Jul26,
        ContextMonth = 8, Aug26,
        ContextMonth = 9, Sep26,
        ContextMonth = 10, Oct26,
        ContextMonth = 11, Nov26,
        ContextMonth = 12, Dec26,
        BLANK ()
    )
)
